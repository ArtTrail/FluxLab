<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="SimpleFitsViewer.Views.AboutView"
             Background="{StaticResource BrushBg}">

    <ScrollViewer>
        <Border Padding="36,28,36,28">
            <StackPanel Spacing="0">

                <Image Source="avares://FluxLab/Assets/FluxLab_logo.png" Width="120" Height="120"
                       HorizontalAlignment="Center" Margin="0,0,0,12"/>

                <TextBlock Classes="title" Text="FluxLab" HorizontalAlignment="Center"/>
                <TextBlock x:Name="VersionText" Classes="hint"
                           HorizontalAlignment="Center" Margin="0,4,0,0"/>
                <TextBlock Classes="hint" Text="© Art Trail 2026"
                           HorizontalAlignment="Center" Margin="0,4,0,0"/>

                <Rectangle Height="1" Fill="{StaticResource BrushSep}" Margin="0,18,0,18"/>

                <TextBlock Classes="body" TextWrapping="Wrap"
                           HorizontalAlignment="Center" TextAlignment="Center"
                           Text="A desktop viewer and aperture-photometry tool for FITS astronomy images, built around determining the right exposure time for exoplanet-transit and variable-star photometry."/>

                <Rectangle Height="1" Fill="{StaticResource BrushSep}" Margin="0,18,0,18"/>

                <TextBlock Classes="body" Text="Author" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                <TextBlock Classes="body" Text="Art Trail" HorizontalAlignment="Center" Margin="0,4,0,2"/>
                <TextBlock Classes="hint" Text="art.trail@icloud.com" HorizontalAlignment="Center" Margin="0,0,0,2"/>
                <TextBlock Classes="hint" Text="github.com/ArtTrail/FluxLab" HorizontalAlignment="Center"/>

                <TextBlock Classes="hint" TextWrapping="Wrap"
                           HorizontalAlignment="Center" TextAlignment="Center" Margin="0,10,0,0"
                           Text="Developed entirely with Claude Code (Anthropic)."/>

                <Rectangle Height="1" Fill="{StaticResource BrushSep}" Margin="0,18,0,18"/>

                <TextBlock Classes="body" Text="Acknowledgements" FontWeight="SemiBold"
                           HorizontalAlignment="Center" Margin="0,0,0,12"/>

                <TextBlock Classes="body" TextWrapping="Wrap" HorizontalAlignment="Center" TextAlignment="Center"
                           Text="astropy"/>
                <TextBlock Classes="hint" TextWrapping="Wrap" HorizontalAlignment="Center" TextAlignment="Center"
                           Margin="0,2,0,10"
                           Text="Reference implementation the hand-rolled ZScale, WCS (TAN+SIP) and photometry were validated against&#x0a;astropy.org"/>

                <TextBlock Classes="body" TextWrapping="Wrap" HorizontalAlignment="Center" TextAlignment="Center"
                           Text="StarFix"/>
                <TextBlock Classes="hint" TextWrapping="Wrap" HorizontalAlignment="Center" TextAlignment="Center"
                           Margin="0,2,0,0"
                           Text="Optional plate-solving engine FluxLab drives for the Plate Solve button"/>
                <Button Classes="link" Content="github.com/ArtTrail/StarFix" Click="OnLinkClick"
                        Tag="https://github.com/ArtTrail/StarFix"
                        HorizontalAlignment="Center" Margin="0,2,0,10"/>

                <TextBlock Classes="body" TextWrapping="Wrap" HorizontalAlignment="Center" TextAlignment="Center"
                           Text="AAVSO VSX  ·  NASA Exoplanet Archive  ·  SIMBAD"/>
                <TextBlock Classes="hint" TextWrapping="Wrap" HorizontalAlignment="Center" TextAlignment="Center"
                           Margin="0,2,0,10"
                           Text="Target-name resolution for Find Target&#x0a;vsx.aavso.org  ·  exoplanetarchive.ipac.caltech.edu  ·  simbad.u-strasbg.fr"/>

                <TextBlock Classes="body" TextWrapping="Wrap" HorizontalAlignment="Center" TextAlignment="Center"
                           Text="Avalonia  ·  CommunityToolkit.Mvvm"/>
                <TextBlock Classes="hint" TextWrapping="Wrap" HorizontalAlignment="Center" TextAlignment="Center"
                           Margin="0,2,0,0"
                           Text="Cross-platform .NET UI framework and MVVM toolkit&#x0a;avaloniaui.net"/>

                <Rectangle Height="1" Fill="{StaticResource BrushSep}" Margin="0,18,0,18"/>

                <TextBlock Classes="body" Text="License" FontWeight="SemiBold"
                           HorizontalAlignment="Center" Margin="0,0,0,8"/>
                <TextBlock Classes="hint" TextWrapping="Wrap" HorizontalAlignment="Center" TextAlignment="Center"
                           Text="Released under the MIT License.&#x0a;See the LICENSE file included with FluxLab for the full text."/>

            </StackPanel>
        </Border>
    </ScrollViewer>

</UserControl>
